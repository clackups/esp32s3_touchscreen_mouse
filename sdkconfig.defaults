# sdkconfig.defaults
# Default SDK configuration for the ESP32-S3 touchscreen mouse project.
# Generated options are applied on top of IDF defaults when running:
#   idf.py set-target esp32s3
#
# Do NOT add CONFIG_IDF_TARGET here; it is set by "idf.py set-target".

# ---- CPU / Clock ----
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

# ---- PSRAM (required for the RGB LCD framebuffer) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# ---- Flash ----
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- FreeRTOS ----
CONFIG_FREERTOS_HZ=1000

# ---- USB / TinyUSB (HID device) ----
CONFIG_TINYUSB_ENABLED=y
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_DESC_USE_ESPRESSIF_VID=n
CONFIG_TINYUSB_DESC_CUSTOM_VID=0xCAFE
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x4004
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="ESP32S3"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Touchscreen Mouse"
CONFIG_TINYUSB_DESC_SERIAL_STRING="000001"

# ---- Logging ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
